# v0.1.0 测试用 .env 文件
# 验证：基础解析、注释、空行、引号、敏感值识别、被注释变量、重复 key 错误
# 使用方法：上传此文件到 EnvBoard，应正确解析为变量表格

# ===== 数据库配置 =====
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
DB_HOST=localhost
DB_PORT=5432

# ===== 应用配置 =====
APP_NAME=EnvBoard
PORT=3000
HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=info

# 含空格的值（无需引号也能解析，但建议加引号）
WELCOME_MESSAGE=Hello World

# 双引号包裹（保留特殊字符）
REGEX_PATTERN="^\\d{3}-\\d{4}$"

# 单引号包裹（原样输出）
LITERAL_DOLLAR='$HOME/path'

# ===== API 密钥（敏感，自动识别） =====
API_KEY=sk-1234567890abcdef
SECRET_KEY=super-secret-value
JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# 内联注释（# 前有空格才视为注释）
CACHE_TTL=3600 # 默认缓存 1 小时

# 被注释掉的变量（行首 # 且含 =）
# DISABLED_FEATURE=false
# OLD_API_KEY=deprecated

# 重复 key（应报错）
DB_PORT=6543

# 格式错误（无 = 号，应报错）
THIS_IS_INVALID_LINE
