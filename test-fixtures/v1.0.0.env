# EnvBoard v1.0.0 测试示例
# 验证功能：搜索替换、敏感值识别（v1.0.0 修复误判）、YAML 导出类型漂移修复
#
# 搜索替换测试：
# 1. 上传本文件
# 2. 点击工具栏「搜索替换」按钮
# 3. 查找 "localhost" 替换为 "127.0.0.1"，勾选「变量值」
#    预期：DATABASE_URL / REDIS_URL / API_BASE_URL 三处匹配
# 4. 查找 "DEV" 替换为 "PROD"，勾选「变量名」「变量值」
#    预期：DEV_MODE 变量名改为 PROD_MODE，值为 false
#
# 敏感值识别测试（v1.0.0 修复）：
# - DB_PASSWORD 应识别为敏感（含 PASSWORD 段）
# - API_KEY 应识别为敏感（含 API_KEY 段）
# - MONKEY_NAME 不应识别为敏感（含 KEY 但分段后为 MONKEY，不匹配）
# - AUTHOR_NAME 不应识别为敏感（含 AUTH 但分段后为 AUTHOR，不匹配）
#
# YAML 导出测试：
# - 导出为 YAML，DEBUG 值 "true" 应加引号 "true"
# - PORT 值 "3000" 应加引号 "3000"
# - APP_NAME 值 "myapp" 不加引号

# 应用配置
APP_NAME=myapp
APP_ENV=development
DEBUG=true
PORT=3000

# 数据库配置（敏感值）
DATABASE_URL=postgres://localhost:5432/myapp_dev
DB_PASSWORD=super-secret-password

# 缓存配置
REDIS_URL=redis://localhost:6379/0

# API 配置（敏感值）
API_KEY=sk-dev-1234567890abcdef
API_BASE_URL=https://api.localhost.com/v1

# 开发模式标记
DEV_MODE=true

# 非敏感变量（验证误判修复）
MONKEY_NAME=gorilla
AUTHOR_NAME=envboard
