# v0.3.0 测试用 .env.development（多文件模式）
# 验证：多文件导入、文件名识别环境
# 使用方法：
#   1. 先上传 v0.3.0.env.all 进入多环境模式
#   2. 点击「+ 追加环境文件」按钮，选择此文件和 v0.3.0.env.production
#   3. 应自动识别为 development 环境
# 或：直接上传此文件，再用追加按钮上传 v0.3.0.env.production
NODE_ENV=development
APP_NAME=EnvBoard-FileMode
APP_PORT=3000
DEBUG=true
DB_HOST=localhost
DB_PORT=5432
API_KEY=dev-api-key-12345
