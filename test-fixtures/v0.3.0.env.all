# v0.3.0 测试用单文件多环境 .env
# 验证：多环境解析（# @env 分段）、环境切换、环境对比、多环境导出
# 使用方法：上传此文件，应自动进入多环境模式，顶部出现环境切换器
# 预期：
#   - 识别出 development / staging / production 三个环境
#   - 对比视图显示：DB_HOST 值不同、REDIS_URL 部分缺失、APP_NAME 完全一致

# @env development
NODE_ENV=development
APP_NAME=EnvBoard
APP_PORT=3000
DEBUG=true
LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379

# @env staging
NODE_ENV=staging
APP_NAME=EnvBoard
APP_PORT=3000
DEBUG=false
LOG_LEVEL=info
DB_HOST=staging-db.example.com
DB_PORT=5432
REDIS_URL=redis://staging-redis:6379

# @env production
NODE_ENV=production
APP_NAME=EnvBoard
APP_PORT=8080
DEBUG=false
LOG_LEVEL=warn
DB_HOST=prod-db.example.com
DB_PORT=5432
# production 不配置 REDIS_URL（对比应显示部分缺失）
