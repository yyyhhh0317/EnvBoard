# v0.4.0 CLI 测试示例
# 用于验证 CLI scan / edit 命令的解析与编辑能力
# 包含：注释、空行、引号、敏感值、被注释变量、多种值类型

# ===== 应用配置 =====
APP_NAME=EnvBoardCLI
APP_PORT=3000
APP_DEBUG=true

# ===== 数据库配置 =====
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
DB_PASSWORD=s3cr3t-key-123

# ===== API 密钥（敏感值） =====
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=your-jwt-secret-here

# ===== 被注释的变量（应识别为 disabled） =====
# OLD_FEATURE_FLAG=false

# ===== 带引号的值 =====
WELCOME_MESSAGE="Hello, EnvBoard CLI!"
LOG_FORMAT=%{time} %{level} %{message}

# ===== 空值 =====
EMPTY_VAR=

# ===== 数字与布尔 =====
MAX_CONNECTIONS=100
ENABLE_CACHE=false
