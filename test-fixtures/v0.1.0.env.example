# v0.1.0 测试用 .env.example 文件
# 验证：对比功能（.env vs .env.example）
# 使用方法：先上传 v0.1.0.env，再在对比区上传此文件
# 预期：NEW_KEY 应标记为 extra，DB_PASSWORD 应标记为 missing

# ===== 数据库配置 =====
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=your-password-here

# ===== 应用配置 =====
APP_NAME=EnvBoard
PORT=3000
HOST=0.0.0.0
DEBUG=true
LOG_LEVEL=info

# ===== API 密钥（占位值） =====
API_KEY=your-api-key
SECRET_KEY=your-secret-key
JWT_TOKEN=your-jwt-token

# 此 key 在 .env 中不存在（对比应显示 extra）
NEW_FEATURE_FLAG=true
