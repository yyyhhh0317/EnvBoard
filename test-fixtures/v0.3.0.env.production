# v0.3.0 测试用 .env.production（多文件模式）
# 验证：多文件导入、文件名识别环境、环境对比
# 使用方法：配合 v0.3.0.env.development 一起用「+ 追加环境文件」导入
# 预期：自动识别为 production 环境，对比视图显示与 development 的差异
NODE_ENV=production
APP_NAME=EnvBoard-FileMode
APP_PORT=8080
DEBUG=false
DB_HOST=prod-db.example.com
DB_PORT=5432
API_KEY=prod-api-key-abcdef
SENTRY_DSN=https://xxx@sentry.io/xxx
