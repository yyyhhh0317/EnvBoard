# v0.2.1 测试用 .env 文件
# 验证：变量校验器（命名规范 / 敏感值 / 重复 key / 占位符）
# 使用方法：上传此文件，应在校验列显示对应问题数
# 预期校验结果：
#   - 小写命名警告：apiKey、dbHost
#   - 含空格命名警告：API KEY（含空格）
#   - 重复 key 警告：PORT 出现两次
#   - 敏感值为空错误：SECRET_KEY 为空
#   - 占位符警告：API_KEY=your-api-key-here

# ===== 命名问题 =====
# 含小写字母（建议全大写）
apiKey=abc123
dbHost=localhost

# 含空格（不规范）
API KEY=value-with-space

# ===== 重复 key =====
PORT=3000
PORT=8080

# ===== 敏感值为空 =====
SECRET_KEY=

# ===== 占位符值 =====
API_KEY=your-api-key-here
DB_PASSWORD=change-me

# ===== 正常变量（对照组，应通过校验） =====
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
APP_NAME=EnvBoard
DEBUG=true
LOG_LEVEL=info

# 提示：应用「通用 Web 应用」模板后，可额外触发类型校验
# 例如 APP_PORT=not-a-number 会触发 invalid-number
APP_PORT=3000
